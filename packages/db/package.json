{
  "name": "@type-ninja/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/seed-cli.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@type-ninja/algorithms": "workspace:*",
    "@type-ninja/core": "workspace:*",
    "@type-ninja/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@type-ninja/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "catalog:"
  }
}
