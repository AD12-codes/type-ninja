NODE_ENV=development
PORT=9797

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/typeninja

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Public URL of this API. In production (single container) this is the site URL.
BETTER_AUTH_URL=http://localhost:9797
# Web origin in development. Leave empty in production when the API serves the web build.
CORS_ORIGIN=http://localhost:9898

# Production only: absolute path to the built web app (served by the API)
# WEB_DIST_DIR=/app/apps/web/dist

# Run migrations and seed algorithm content on boot (recommended)
RUN_MIGRATIONS_ON_START=true
SEED_ON_START=true

# Optional social login (hidden on the login page when empty)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP for password reset emails (logged to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=typeninja <no-reply@example.com>

# OAuth callback URLs to register in the GitHub / Google OAuth apps:
#   local:  http://localhost:9797/api/auth/callback/github
#           http://localhost:9797/api/auth/callback/google
#   prod:   https://typeninja.ad12-codes.work/api/auth/callback/github
#           https://typeninja.ad12-codes.work/api/auth/callback/google

# Rate limiting trusts X-Forwarded-For from the reverse proxy (Traefik/Dokploy).
# Set to false only when the API is reachable without a proxy in front of it.
TRUST_PROXY=true
